# {{ ansible_managed }}
# ===============================
# Basic node identity and storage
# ===============================

# Logical name of this etcd member
ETCD_NAME='{{ inventory_hostname }}'

# Data directory for Raft state and WAL
ETCD_DATA_DIR='{{ etcd_data_dir }}'

# ===============================
# Client communication (port 2379)
# ===============================

# Listen on all interfaces
ETCD_LISTEN_CLIENT_URLS='https://0.0.0.0:2379'

# URLs advertised to clients
ETCD_ADVERTISE_CLIENT_URLS='https://{{ node_ip }}:2379,https://127.0.0.1:2379'

# ===============================
# Peer communication (port 2380)
# ===============================

# Listen for peer traffic
ETCD_LISTEN_PEER_URLS='https://0.0.0.0:2380'

# URL advertised to other members
ETCD_INITIAL_ADVERTISE_PEER_URLS='https://{{ node_ip }}:2380'

# ===============================
# Cluster bootstrap configuration
# ===============================

# List of all cluster members
ETCD_INITIAL_CLUSTER='{{ etcd_initial_cluster | trim }}'

# Bootstrap a new cluster
ETCD_INITIAL_CLUSTER_STATE='new'

# Unique cluster identifier
ETCD_INITIAL_CLUSTER_TOKEN='{{ etcd_cluster_token }}'

# ===============================
# TLS configuration - client access
# ===============================

# Server/client certificate
ETCD_CERT_FILE='{{ etcd_cert_dir }}/{{ inventory_hostname }}.crt'

# Private key for certificate
ETCD_KEY_FILE='{{ etcd_cert_dir }}/{{ inventory_hostname }}.key'

# Trusted CA
ETCD_TRUSTED_CA_FILE='{{ etcd_cert_dir }}/ca.crt'

# Enforce client cert auth
ETCD_CLIENT_CERT_AUTH='true'

# ===============================
# TLS configuration - peer access
# ===============================

# Peer certificate
ETCD_PEER_CERT_FILE='{{ etcd_cert_dir }}/{{ inventory_hostname }}.crt'

# Peer private key
ETCD_PEER_KEY_FILE='{{ etcd_cert_dir }}/{{ inventory_hostname }}.key'

# Trusted CA for peers
ETCD_PEER_TRUSTED_CA_FILE='{{ etcd_cert_dir }}/ca.crt'

# Enforce peer cert auth
ETCD_PEER_CLIENT_CERT_AUTH='true'
